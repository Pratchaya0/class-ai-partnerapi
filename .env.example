# Shared workshop key. Clients must send it as the X-Workshop-Key header.
# Set the real value through Vercel Environment Variables - never commit it.
WORKSHOP_API_KEY=change-me

# Artificial delay used by the `timeout` scenario, in milliseconds.
# Clamped to 0..10000 at runtime so it can never exceed the function duration limit.
MOCK_TIMEOUT_MS=5000

# Set to false to disable the random/chaos scenario. When disabled it falls back to success.
ENABLE_RANDOM_SCENARIO=true
